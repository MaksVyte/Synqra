{
	"name": "synqra",
	"version": "0.1.0",
	"description": "Real-time multi-user live collaboration, note syncing, and Excalidraw drawing for Obsidian via a self-hosted relay server.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"collaboration",
		"realtime"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"y-codemirror.next": "^0.3.5",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.32"
	}
}
